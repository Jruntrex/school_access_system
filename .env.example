SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=school_rfid
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Shared secret with the ESP32 readers — verifies the HMAC-SHA256
# signature (X-Timestamp / X-Signature headers) on scan requests.
CARD_SCAN_API_KEY=change-me

# Used to derive card_uid_hash = HMAC_SHA256(secret, normalized_uid).
# Must be a different value than CARD_SCAN_API_KEY.
CARD_UID_HASH_SECRET=change-me-too

# Telegram bot for the daily attendance report (/settings/, `send_daily_report`
# management command). Get TELEGRAM_BOT_TOKEN from @BotFather; TELEGRAM_CHAT_ID
# is the numeric chat id that should receive the report (e.g. from @userinfobot,
# or GET https://api.telegram.org/bot<token>/getUpdates after messaging the bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
